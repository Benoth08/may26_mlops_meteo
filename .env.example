# --- Airflow ---
AIRFLOW_UID=1000
DOCKER_GID=998

POSTGRES_AIRF_USER=airflow
POSTGRES_AIRF_PASSWORD=CHANGE_ME
POSTGRES_AIRF_DB=airflow

AIRFLOW_JWT_SECRET=CHANGE_ME

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME														  	  


# --- Docker ---
AIRFLOW_CONTAINER_DATA_DIR=/opt/airflow/data
AIRFLOW_CONTAINER_LOGS_DIR=/opt/airflow/logs
WEATHER_HOST_DATA_DIR=/home/ubuntu/projet_weather/data
WEATHER_HOST_LOGS_DIR=/home/ubuntu/projet_weather/logs
WEATHER_HOST_MODELS_DIR=/home/ubuntu/projet_weather/models
WEATHER_HOST_METRICS_DIR=/home/ubuntu/projet_weather/metrics
WEATHER_INTEGRATION_IMAGE_TAG=1.4.2
WEATHER_PREPROCESSING_IMAGE_TAG=1.4.2
WEATHER_MODELS_IMAGE_TAG=1.4.2

BETWORK_MODE=weather

# --- Postgres pour données météo ---
POSTGRES_WTH_USER=weather
POSTGRES_WTH_PASSWORD=CHANGE_ME
POSTGRES_WTH_DB=weather					   
POSTGRES_WTH_HOST=weather-postgres
POSTGRES_WTH_PORT=5432


# --- Auth API ---
API_AUTH_USERNAME=CHANGE_ME
API_AUTH_PASSWORD_HASH=CHANGE_ME


# --- MLflow (serveur partage DagsHub) ---
MLFLOW_TRACKING_URI=https://dagshub.com/Benoth08/may26_mlops_meteo.mlflow
MLFLOW_TRACKING_USERNAME=CHANGE_ME
MLFLOW_TRACKING_PASSWORD=CHANGE_ME
