      "targets": [{"expr": "sum by (status) (rate(weather_api_http_requests_total{status=~\"4..|5..\"}[5m]))", "legendFormat": "HTTP {{status}}", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Prédictions Yes / No — temps réel", "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (prediction) (rate(weather_model_predictions_total[5m]))", "legendFormat": "{{prediction}}", "refId": "A"}]
    },
