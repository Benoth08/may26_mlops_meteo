    {
      "type": "timeseries", "title": "API requests/sec", "id": 2,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(weather_api_http_requests_total[1m]))", "legendFormat": "requests/s", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Latence API p95", "id": 3,
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(weather_api_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Erreurs HTTP", "id": 4,
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
