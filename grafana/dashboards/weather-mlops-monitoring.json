      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (prediction) (increase(weather_model_predictions_total[$__range]))", "legendFormat": "{{prediction}}", "refId": "A", "instant": true}]
    },
    {
      "type": "row", "title": "Offline — dernière évaluation du modèle", "id": 7,
